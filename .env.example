# Copie este arquivo para ".env.local" e preencha.
# No seu computador nada disto é obrigatório: sem DATABASE_URL os dados ficam
# em um arquivo dentro da pasta ".dados".

# Banco PostgreSQL — necessário para PUBLICAR o site (ex.: Neon, Supabase).
# As tabelas e os brinquedos iniciais são criados sozinhos no primeiro acesso.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Senha inicial do painel (/admin). Sem esta linha, a senha é "midiversao2026".
# Depois os donos podem trocar a senha pelo próprio painel.
# ADMIN_PASSWORD=troque-esta-senha

# Frase longa e aleatória usada para assinar o login do painel (recomendado ao publicar).
# ADMIN_SECRET=coloque-aqui-uma-frase-longa-e-aleatoria
